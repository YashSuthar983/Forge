# GitHub language statistics (Linguist).
#
# The repository tracks ~150 MB of LP/MILP instance data against ~1 MB of
# actual C++. Left alone, the language bar reports the benchmark corpus rather
# than the solver. These attributes keep every file in the repository and
# visible on GitHub -- they only exclude the data from the language bar.
#
#   linguist-vendored   third-party corpora we redistribute unchanged
#   linguist-generated  instances our own scripts emit (also collapsed in diffs)

# ---- third-party benchmark corpora -----------------------------------------
benchmarks/netlib/**            linguist-vendored
benchmarks/netlib-smoke5/**     linguist-vendored
benchmarks/miplib-easy/**       linguist-vendored
benchmarks/miplib2017/**        linguist-vendored
benchmarks/tools/**             linguist-vendored

# ---- instances generated by scripts/gen_*.py --------------------------------
benchmarks/industrial-ladder/** linguist-generated
benchmarks/industry/**          linguist-generated
benchmarks/synthetic/**         linguist-generated

# ---- benchmark output, not source ------------------------------------------
benchmarks/results/**           linguist-generated

# ---- example models shipped for the demo ------------------------------------
examples/**                     linguist-vendored

# ---- instance formats wherever they appear ----------------------------------
# Netlib also carries extensionless raw files and names like pilot.we /
# pilot.ja, whose trailing component Linguist would otherwise treat as a
# language extension.
*.mps                           linguist-vendored
*.qps                           linguist-vendored
*.lp                            linguist-vendored
*.solu                          linguist-vendored

# ---- keep the actual source counted -----------------------------------------
src/**                          linguist-vendored=false
apps/**                         linguist-vendored=false
tests/**                        linguist-vendored=false
bindings/**                     linguist-vendored=false
tools/**                        linguist-vendored=false
web/**                          linguist-vendored=false
scripts/**                      linguist-vendored=false

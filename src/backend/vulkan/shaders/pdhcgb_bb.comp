#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Batched pdhcg_bb: per-entry Barzilai-Borwein terms s^2 and s*dg.
// Batched layout: lane l of entry j lives at [j*K + l] (lanes interleaved,
// so neighbouring threads touch neighbouring lanes).  mask[l] != 0 selects
// the lanes this dispatch may touch; masked-out lanes are left untouched.

// tau/sigma are PER LANE (a mapped buffer, one value per lane): the primal
// weight rebalances them per lane, so a lane batched with others takes the
// same steps it would take solved alone.

layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint n; uint K; } pc;

layout(std430, binding = 0) readonly  buffer QxBuf    { double qx[]; };
layout(std430, binding = 1) readonly  buffer CBuf     { double c[]; };
layout(std430, binding = 2) readonly  buffer AtyBuf   { double aty[]; };
layout(std430, binding = 3) readonly  buffer TrialBuf { double trial[]; };
layout(std430, binding = 4) readonly  buffer XBuf     { double x[]; };
layout(std430, binding = 5) readonly  buffer XinBuf   { double xin[]; };
layout(std430, binding = 6) readonly  buffer GradBuf  { double grad[]; };
layout(std430, binding = 7) writeonly buffer S2Buf    { double s2[]; };
layout(std430, binding = 8) writeonly buffer SdgBuf   { double sdg[]; };
layout(std430, binding = 9) readonly  buffer MK       { double mask[]; };
layout(std430, binding = 10) readonly buffer TB       { double tau[]; };

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= pc.n * pc.K) return;
    uint j = g / pc.K, l = g - j * pc.K;
    if (mask[l] == 0.0lf) return;
    double t = trial[g];
    double gn = qx[g] + c[j] + aty[g] + (t - x[g]) / tau[l];
    double s = t - xin[g];
    s2[g] = s * s;
    sdg[g] = s * (gn - grad[g]);
}

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Reflected Halpern step for the device-resident HPR operator:
//   z <- (1-beta) * ((1+gamma) * T(z) - gamma * z) + beta * anchor
// with T(z) read from its own buffer, so the un-mixed T(z) stays available
// (the rHPDHG restart point). beta = gamma = 0 is the plain step z <- T(z).
// Each invocation reads z[i] before writing it, so z may be updated in place.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint pad;
    double beta;
    double gamma;
} pc;

layout(std430, binding = 0) buffer ZBuf { double z[]; };
layout(std430, binding = 1) readonly buffer TBuf { double t[]; };
layout(std430, binding = 2) readonly buffer AnchorBuf { double anchor[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    double reflected = (1.0lf + pc.gamma) * t[i] - pc.gamma * z[i];
    z[i] = (1.0lf - pc.beta) * reflected + pc.beta * anchor[i];
}

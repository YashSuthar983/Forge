#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Halpern mix toward the epoch anchor. When gamma > 0 this is r²HPDHG:
//   z <- (1-beta) * ((1+gamma)*T(z) - gamma*z_old) + beta * anchor
// with z[] holding T(z) on entry. gamma == 0 recovers plain rHPDHG.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint pad;
    double beta;
    double gamma;
} pc;

layout(std430, binding = 0) buffer ZBuf { double z[]; };
layout(std430, binding = 1) readonly buffer AnchorBuf { double anchor[]; };
layout(std430, binding = 2) readonly buffer OldBuf { double oldz[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    double b = pc.beta;
    double t = z[i];
    double reflected = (1.0lf + pc.gamma) * t - pc.gamma * oldz[i];
    z[i] = (1.0lf - b) * reflected + b * anchor[i];
}

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Inner-loop gradient of phi(u) = 1/2 u'Qu + (c + A'y)'u + ||u - x||^2/(2 tau)
// at u = xin, plus the per-entry projected-gradient residual the host
// max-reduces for the loop's stopping test:
//   grad = Q xin + c + aty + (xin - x)/tau
//   pg   = |xin - clamp(xin - grad, lo, hi)|

layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint n; uint pad; double tau; } pc;

layout(std430, binding = 0) readonly  buffer QxBuf   { double qx[]; };
layout(std430, binding = 1) readonly  buffer CBuf    { double c[]; };
layout(std430, binding = 2) readonly  buffer AtyBuf  { double aty[]; };
layout(std430, binding = 3) readonly  buffer XinBuf  { double xin[]; };
layout(std430, binding = 4) readonly  buffer XBuf    { double x[]; };
layout(std430, binding = 5) readonly  buffer LoBuf   { double lo[]; };
layout(std430, binding = 6) readonly  buffer HiBuf   { double hi[]; };
layout(std430, binding = 7) writeonly buffer GradBuf { double grad[]; };
layout(std430, binding = 8) writeonly buffer PgBuf   { double pg[]; };

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.n) return;
    double u = xin[j];
    double g = qx[j] + c[j] + aty[j] + (u - x[j]) / pc.tau;
    grad[j] = g;
    double z = max(lo[j], min(u - g, hi[j]));
    pg[j] = abs(u - z);
}

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Batched pdhcg_trial with a per-lane step: trial = clamp(xin - alpha_l grad).
// Batched layout: lane l of entry j lives at [j*K + l] (lanes interleaved,
// so neighbouring threads touch neighbouring lanes).  mask[l] != 0 selects
// the lanes this dispatch may touch; masked-out lanes are left untouched.

layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint n; uint K; } pc;

layout(std430, binding = 0) readonly  buffer XinBuf   { double xin[]; };
layout(std430, binding = 1) readonly  buffer GradBuf  { double grad[]; };
layout(std430, binding = 2) readonly  buffer LoBuf    { double lo[]; };
layout(std430, binding = 3) readonly  buffer HiBuf    { double hi[]; };
layout(std430, binding = 4) writeonly buffer TrialBuf { double trial[]; };
layout(std430, binding = 5) readonly  buffer AlBuf    { double alpha[]; };
layout(std430, binding = 6) readonly  buffer MK       { double mask[]; };

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= pc.n * pc.K) return;
    uint l = g % pc.K;
    if (mask[l] == 0.0lf) return;
    trial[g] = max(lo[g], min(xin[g] - alpha[l] * grad[g], hi[g]));
}

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Row terms of the PDHCG-II convergence check:
//   viol = distance of Ax outside [lo, hi]                -> max
//   dres = |Ax - clamp(Ax + y, lo, hi)|  (natural map)    -> max
//   py = support of [lo, hi] at y ; pinf = infinite flag  -> sum / max

layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint m; } pc;

layout(std430, binding = 0) readonly  buffer AxBuf   { double ax[]; };
layout(std430, binding = 1) readonly  buffer YBuf    { double y[]; };
layout(std430, binding = 2) readonly  buffer LoBuf   { double lo[]; };
layout(std430, binding = 3) readonly  buffer HiBuf   { double hi[]; };
layout(std430, binding = 4) writeonly buffer ViolBuf { double viol[]; };
layout(std430, binding = 5) writeonly buffer DresBuf { double dres[]; };
layout(std430, binding = 6) writeonly buffer PyBuf   { double py[]; };
layout(std430, binding = 7) writeonly buffer PinfBuf { double pinf[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.m) return;
    double a = ax[i], yi = y[i], l = lo[i], h = hi[i];
    double v = 0.0lf;
    if (a < l) v = l - a;
    if (a > h) v = max(v, a - h);
    viol[i] = v;
    dres[i] = abs(a - max(l, min(a + yi, h)));
    double p = 0.0lf, f = 0.0lf;
    if (yi > 0.0lf) { if (isinf(h)) f = 1.0lf; else p = h * yi; }
    else if (yi < 0.0lf) { if (isinf(l)) f = 1.0lf; else p = l * yi; }
    py[i] = p;
    pinf[i] = f;
}

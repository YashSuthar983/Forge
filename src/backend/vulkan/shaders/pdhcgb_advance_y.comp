#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Batched pdhcg_advance_y: v = y_old + sigma A xbar; yc = v - sigma
// clamp(v/sigma, lo, hi); y_new = yc or the reflected Halpern mix.
// Batched layout: lane l of entry j lives at [j*K + l] (lanes interleaved,
// so neighbouring threads touch neighbouring lanes).  mask[l] != 0 selects
// the lanes this dispatch may touch; masked-out lanes are left untouched.

// tau/sigma are PER LANE (a mapped buffer, one value per lane): the primal
// weight rebalances them per lane, so a lane batched with others takes the
// same steps it would take solved alone.

layout(local_size_x = 256) in;
layout(push_constant) uniform PC {
    uint m; uint K; uint halpern; uint pad; double a; double t;
} pc;

layout(std430, binding = 0) readonly  buffer AxbBuf   { double axbar[]; };
layout(std430, binding = 1) readonly  buffer LoBuf    { double lo[]; };
layout(std430, binding = 2) readonly  buffer HiBuf    { double hi[]; };
layout(std430, binding = 3) readonly  buffer Y0Buf    { double y0[]; };
layout(std430, binding = 4) buffer YprevBuf           { double yprev[]; };
layout(std430, binding = 5) buffer YBuf               { double y[]; };
layout(std430, binding = 6) readonly  buffer MK       { double mask[]; };
layout(std430, binding = 7) readonly  buffer SB       { double sigma[]; };

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= pc.m * pc.K) return;
    uint l = g % pc.K;
    if (mask[l] == 0.0lf) return;
    double sg = sigma[l];
    double yo = y[g];
    double v = yo + sg * axbar[g];
    double yc = v - sg * max(lo[g], min(v / sg, hi[g]));
    double yn = yc;
    if (pc.halpern != 0u)
        yn = (1.0lf + pc.t) * (pc.a * yc + (1.0lf - pc.a) * y0[g]) - pc.t * yprev[g];
    yprev[g] = yo;
    y[g] = yn;
}

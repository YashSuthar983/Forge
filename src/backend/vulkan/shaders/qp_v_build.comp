#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// v = xhat + sigma*(Qw - Q*xhat)/(1 + sigma*lambda_Q)
//
// The vector A then multiplies.  Kept separate from qp_x_step only because
// Q*xhat cannot exist until xhat does, and that is a matvec boundary -- not
// a fusion opportunity we are declining.

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint pad;
    double sigma;
    double den;      // 1 + sigma*lambda_Q, precomputed on the host
} pc;

layout(std430, binding = 0) readonly  buffer XhatBuf  { double xhat[]; };
layout(std430, binding = 1) readonly  buffer QwBuf    { double qw[]; };
layout(std430, binding = 2) readonly  buffer QxhatBuf { double qxhat[]; };
layout(std430, binding = 3) writeonly buffer VBuf     { double v[]; };

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.n) return;
    v[j] = xhat[j] + pc.sigma * (qw[j] - qxhat[j]) / pc.den;
}

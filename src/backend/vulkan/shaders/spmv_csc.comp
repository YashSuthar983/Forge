#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n_cols;
} pc;

layout(std430, binding = 0) readonly buffer ColPtr { int col_ptr[]; };
layout(std430, binding = 1) readonly buffer RowIdx { int row_idx[]; };
layout(std430, binding = 2) readonly buffer Vals   { double vals[]; };
layout(std430, binding = 3) readonly buffer XBuf   { double x[]; };
layout(std430, binding = 4) writeonly buffer YBuf  { double y[]; };

void main() {
    uint j = gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
    if (j >= pc.n_cols) return;

    int start = col_ptr[j];
    int end   = col_ptr[j + 1];
    double acc = 0.0lf;
    for (int k = start + int(gl_SubgroupInvocationID); k < end; k += int(gl_SubgroupSize))
        acc += vals[k] * x[row_idx[k]];

    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) {
        y[j] = acc;
    }
}


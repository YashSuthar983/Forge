#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// r2HPDHG combine step, applied identically to x, y and the maintained
// A*x_current:
//
//     z <- (1 - beta) * ((1 + gamma) * T(z) - gamma * z) + beta * anchor
//
// gamma = 0 and beta = 0 collapses this to a plain z <- T(z) copy, which is
// why the non-Halpern, non-reflected path uses the same dispatch rather than
// a separate kernel: one code path, one place for the algebra to be wrong.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint pad;
    double beta;
    double gamma;
} pc;

layout(std430, binding = 0) buffer ZBuf           { double z[]; };
layout(std430, binding = 1) readonly buffer ZFix  { double zfix[]; };
layout(std430, binding = 2) readonly buffer Anch  { double anchor[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    double reflected = (1.0lf + pc.gamma) * zfix[i] - pc.gamma * z[i];
    z[i] = (1.0lf - pc.beta) * reflected + pc.beta * anchor[i];
}

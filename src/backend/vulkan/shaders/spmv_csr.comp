#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n_rows;
} pc;

layout(std430, binding = 0) readonly buffer RowPtr { int row_ptr[]; };
layout(std430, binding = 1) readonly buffer ColIdx { int col_idx[]; };
layout(std430, binding = 2) readonly buffer Vals   { double vals[]; };
layout(std430, binding = 3) readonly buffer XBuf   { double x[]; };
layout(std430, binding = 4) writeonly buffer YBuf  { double y[]; };

void main() {
    uint r = gl_WorkGroupID.x * gl_NumSubgroups + gl_SubgroupID;
    if (r >= pc.n_rows) return;

    int start = row_ptr[r];
    int end   = row_ptr[r + 1];
    double acc = 0.0lf;
    for (int k = start + int(gl_SubgroupInvocationID); k < end; k += int(gl_SubgroupSize))
        acc += vals[k] * x[col_idx[k]];

    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) {
        y[r] = acc;
    }
}


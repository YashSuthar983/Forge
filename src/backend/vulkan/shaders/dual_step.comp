#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Dual half-step: Moreau prox of the indicator of the row box.
//
// Also emits the two per-row quantities the adaptive-step controller needs,
// so that no vector ever has to be read back to test the operator
// inequality:  ||dy||^2 and <A dx, dy>.  ax holds A*(2*T_x - x), so
// A(T_x - x) = (ax - ax_cur)/2 -- the same algebraic shortcut the CPU device
// uses to avoid a third SpMV per iteration.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n_rows;
    uint pad;
    double sigma;
} pc;

layout(std430, binding = 0) readonly  buffer YBuf      { double y[]; };
layout(std430, binding = 1) readonly  buffer AxBuf     { double ax[]; };
layout(std430, binding = 2) readonly  buffer LoBuf     { double lo[]; };
layout(std430, binding = 3) readonly  buffer HiBuf     { double hi[]; };
layout(std430, binding = 4) readonly  buffer AxCurBuf  { double ax_cur[]; };
layout(std430, binding = 5) writeonly buffer YfixBuf   { double yfix[]; };
layout(std430, binding = 6) writeonly buffer AxFixBuf  { double ax_fix[]; };
layout(std430, binding = 7) writeonly buffer Dy2Buf    { double dy2[]; };
layout(std430, binding = 8) writeonly buffer InterBuf  { double inter[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_rows) return;
    double yi = y[i];
    double v = yi + pc.sigma * ax[i];
    double z = v / pc.sigma;
    if (z < lo[i]) z = lo[i];
    if (z > hi[i]) z = hi[i];
    double yn = v - pc.sigma * z;
    double d = yn - yi;
    double adx = 0.5lf * (ax[i] - ax_cur[i]);
    yfix[i]   = yn;
    ax_fix[i] = 0.5lf * (ax[i] + ax_cur[i]);
    dy2[i]    = d * d;
    inter[i]  = adx * d;
}

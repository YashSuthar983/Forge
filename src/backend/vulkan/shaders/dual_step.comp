#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n_rows;
    double sigma;
} pc;

layout(std430, binding = 0) buffer YBuf { double y[]; };
layout(std430, binding = 1) readonly buffer AxBuf { double ax[]; };
layout(std430, binding = 2) readonly buffer LoBuf { double lo[]; };
layout(std430, binding = 3) readonly buffer HiBuf { double hi[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_rows) return;
    double v = y[i] + pc.sigma * ax[i];
    double z = v / pc.sigma;
    if (z < lo[i]) z = lo[i];
    if (z > hi[i]) z = hi[i];
    y[i] = v - pc.sigma * z;
}

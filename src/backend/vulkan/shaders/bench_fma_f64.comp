#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// sor_gpu_bench only (not in any solve path): peak double FMA throughput.
// Eight independent accumulator chains per thread hide FMA latency; the
// operands depend on the thread id and the results are stored, so the
// compiler can neither constant-fold nor discard the loop.  Each iteration
// is 8 FMAs = 16 flops per thread.

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint iters;
    uint pad;
} pc;

layout(std430, binding = 0) writeonly buffer OutBuf { double outv[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    double s = double(i & 1023u) * double(1.0e-7);
    double b = double(0.999999) + s * double(1.0e-3);
    double c = double(1.0e-6);
    double a0 = s, a1 = s + double(1), a2 = s + double(2), a3 = s + double(3);
    double a4 = s + double(4), a5 = s + double(5), a6 = s + double(6), a7 = s + double(7);
    for (uint k = 0u; k < pc.iters; ++k) {
        a0 = fma(a0, b, c); a1 = fma(a1, b, c); a2 = fma(a2, b, c); a3 = fma(a3, b, c);
        a4 = fma(a4, b, c); a5 = fma(a5, b, c); a6 = fma(a6, b, c); a7 = fma(a7, b, c);
    }
    outv[i] = ((a0 + a1) + (a2 + a3)) + ((a4 + a5) + (a6 + a7));
}

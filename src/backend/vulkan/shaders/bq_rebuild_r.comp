#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Restart: r = A x from scratch for flagged searches, P x m threads.
// Per-search state, 16 doubles per search:
//   0 obj  1 viol  2 penalty  3 best_obj  4 best_viol  5 iter  6 since_improve
//   7 have_feasible  8 chosen  9 improved  10 stalled  11 restart  12 base

// Arithmetic that feeds a decision is declared `precise`: it forbids the
// compiler contracting a*b+c into an FMA, which would round differently
// from the CPU oracle (built with -ffp-contract=off) and could flip a tie.

layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint n; uint m; uint P; uint pad; } pc;

layout(std430, binding = 0) readonly buffer XB  { double x[]; };
layout(std430, binding = 1) writeonly buffer RB { double r[]; };
layout(std430, binding = 2) readonly buffer ARS { int a_rstart[]; };
layout(std430, binding = 3) readonly buffer ARC { int a_rcol[]; };
layout(std430, binding = 4) readonly buffer ARV { double a_rval[]; };
layout(std430, binding = 5) readonly buffer STB { double st[]; };

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= pc.m * pc.P) return;
    uint s = g / pc.m, i = g - s * pc.m;
    if (st[s * 16u + 11u] == 0.0lf) return;
    precise double acc = 0.0lf;
    for (int k = a_rstart[i]; k < a_rstart[i + 1]; ++k)
        acc += a_rval[k] * x[s * pc.n + uint(a_rcol[k])];
    r[g] = acc;
}

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint n; } pc;
layout(std430, binding = 0) readonly buffer CloBuf { double clo[]; };
layout(std430, binding = 1) readonly buffer ChiBuf { double chi[]; };
layout(std430, binding = 2) writeonly buffer XBuf { double x[]; };
layout(std430, binding = 3) writeonly buffer X0Buf { double x0[]; };
layout(std430, binding = 4) writeonly buffer XpBuf { double xp[]; };

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.n) return;
    double l = clo[j], h = chi[j];
    double v = max(l, min(0.0lf, h));
    x[j] = v;
    x0[j] = v;
    xp[j] = v;
}

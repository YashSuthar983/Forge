#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint count;
} pc;

layout(std430, binding = 0) readonly buffer ZBuf { double z[]; };
layout(std430, binding = 1) buffer AvgBuf { double avg[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    double inv = 1.0lf / double(pc.count);
    avg[i] += (z[i] - avg[i]) * inv;
}

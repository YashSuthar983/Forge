#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Cooperative product for long rows/columns: one workgroup per listed
// vector, 256 invocations striding over its entries, then a fixed-order
// shared-memory tree, so the result is deterministic run to run.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n_long;
} pc;

layout(std430, binding = 0) readonly buffer Ptr  { int ptr[]; };
layout(std430, binding = 1) readonly buffer Idx  { int idx[]; };
layout(std430, binding = 2) readonly buffer Vals { double vals[]; };
layout(std430, binding = 3) readonly buffer XBuf { double x[]; };
layout(std430, binding = 4) writeonly buffer YBuf { double y[]; };
layout(std430, binding = 5) readonly buffer List { uint list[]; };

shared double s_red[256];

void main() {
    uint g = gl_WorkGroupID.x;
    if (g >= pc.n_long) return;   // uniform per workgroup: barriers stay legal
    uint r = list[g];
    uint t = gl_LocalInvocationID.x;
    double acc = 0.0lf;
    for (int k = ptr[r] + int(t); k < ptr[r + 1]; k += 256)
        acc += vals[k] * x[idx[k]];
    s_red[t] = acc;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (t < s) s_red[t] += s_red[t + s];
        barrier();
    }
    if (t == 0u) y[r] = s_red[0];
}

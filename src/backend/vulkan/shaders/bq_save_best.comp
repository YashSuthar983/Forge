#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Parallel binquad, kernel 4 of 4: best_x = x where the search improved.
// Per-search state, 16 doubles per search:
//   0 obj  1 viol  2 penalty  3 best_obj  4 best_viol  5 iter  6 since_improve
//   7 have_feasible  8 chosen  9 improved  10 stalled  11 restart  12 base

layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint n; uint P; } pc;

layout(std430, binding = 0) readonly buffer XB  { double x[]; };
layout(std430, binding = 1) buffer BXB          { double best_x[]; };
layout(std430, binding = 2) readonly buffer STB { double st[]; };

void main() {
    uint g = gl_GlobalInvocationID.x;
    if (g >= pc.n * pc.P) return;
    uint s = g / pc.n;
    if (st[s * 16u + 9u] != 0.0lf) best_x[g] = x[g];
}

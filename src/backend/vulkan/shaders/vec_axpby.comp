#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// z = alpha*x + beta*y.  The one elementwise primitive the QP reductions
// need (differences against the epoch anchor, A'dy - Q dw), and the axpy
// PDHCG's conjugate-gradient loop is built from.

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint pad;
    double alpha;
    double beta;
} pc;

layout(std430, binding = 0) readonly  buffer XBuf { double x[]; };
layout(std430, binding = 1) readonly  buffer YBuf { double y[]; };
layout(std430, binding = 2) writeonly buffer ZBuf { double z[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    z[i] = pc.alpha * x[i] + pc.beta * y[i];
}

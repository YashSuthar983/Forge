#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

// Primal half of the move to the next iterate, FUSED: everything that needs
// the old x reads it from one register before x is overwritten.
//   xbar   = 2 xc - x_old                    (consumed by the A xbar matvec)
//   x_new  = xc, or the reflected Halpern mix
//            (1+t)(a xc + (1-a) x0) - t x_prev
//   x_prev = x_old ;  mv = (x_new - x_old)^2 ;  x = x_new

layout(local_size_x = 256) in;
layout(push_constant) uniform PC { uint n; uint halpern; double a; double t; } pc;

layout(std430, binding = 0) readonly  buffer XcBuf    { double xc[]; };
layout(std430, binding = 1) readonly  buffer X0Buf    { double x0[]; };
layout(std430, binding = 2) buffer XprevBuf           { double xprev[]; };
layout(std430, binding = 3) buffer XBuf               { double x[]; };
layout(std430, binding = 4) writeonly buffer XbarBuf  { double xbar[]; };
layout(std430, binding = 5) writeonly buffer MvBuf    { double mv[]; };

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.n) return;
    double xo = x[j];
    double cand = xc[j];
    xbar[j] = 2.0lf * cand - xo;
    double xn = cand;
    if (pc.halpern != 0u)
        xn = (1.0lf + pc.t) * (pc.a * cand + (1.0lf - pc.a) * x0[j]) - pc.t * xprev[j];
    xprev[j] = xo;
    double d = xn - xo;
    mv[j] = d * d;
    x[j] = xn;
}

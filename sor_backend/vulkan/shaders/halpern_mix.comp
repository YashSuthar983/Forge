#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require

layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    double beta;
} pc;

layout(std430, binding = 0) buffer ZBuf { double z[]; };
layout(std430, binding = 1) readonly buffer AnchorBuf { double anchor[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    double b = pc.beta;
    z[i] = (1.0lf - b) * z[i] + b * anchor[i];
}

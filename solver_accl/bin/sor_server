#!/usr/bin/env julia
# Persistent solve server. A caller (typically C++) spawns this once, waits for
# SORACCL_READY on stderr, then writes one request per line to stdin and reads
# one JSON object per line from stdout.
#
# Spawning once and keeping it resident is the point: Julia's startup and the
# first GPU-vendor package load cost seconds, and paying that per solve would
# dominate every measurement.
const ROOT = normpath(joinpath(@__DIR__, ".."))
import Pkg
Pkg.activate(ROOT; io=devnull)
include(joinpath(ROOT, "src", "SovereignSolver.jl"))
using .SovereignSolver
serve()
